# Copiar a .env.local y completar con los datos del proyecto de Supabase
# (Project Settings → API).
#
# Sin estas variables la app levanta igual, pero usa la implementación en
# memoria: los datos se pierden al reiniciar y cada instancia ve su propio
# estado. Para la demo en vivo hacen falta sí o sí.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# La anon key es pública por diseño: va al navegador y está protegida por las
# políticas RLS de supabase/schema.sql. La service_role key NO se usa en este
# proyecto y no debe llegar nunca al cliente.
